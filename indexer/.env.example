# Local services run with Podman (see README): Postgres on 5433, Hasura on 8080
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=5433
ENVIO_PG_USER=envio
ENVIO_PG_PASSWORD=envio
ENVIO_PG_DATABASE=envio-dev
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/metadata
HASURA_GRAPHQL_ADMIN_SECRET=testing
# Monad's public RPC hangs on eth_getLogs ranges over ~100 blocks
ENVIO_RPC_INITIAL_BLOCK_INTERVAL=100
ENVIO_RPC_INTERVAL_CEILING=100
ENVIO_TUI=false
# Paste a free token from https://envio.dev/app/api-tokens to sync via HyperSync instead of RPC
# ENVIO_API_TOKEN=
# ENVIO_RPC_URL=https://<your-endpoint>.monad-testnet.quiknode.pro/<token>/
