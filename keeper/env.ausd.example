# Copy to .env.ausd (git ignored). Testnet only. Keep this keeper off while the hosted keeper uses the same keys.
RPC_URL=https://testnet-rpc.monad.xyz
# Optional same-chain backup; never commit provider credentials.
# RPC_BACKUP_URL=https://your-backup-provider.example/rpc
PERPL_RPC_URL=https://testnet-rpc.monad.xyz
# PERPL_RPC_BACKUP_URL=https://your-backup-provider.example/rpc
KEEPER_KEY=replace-with-testnet-arena-owner-key
RELAYER_KEY=replace-with-separate-testnet-sponsor-key
BOT_MNEMONIC="replace-with-testnet-bot-mnemonic"
BOT_COUNT=2
BOT_FILL_AFTER=12
BOT_FUND_STAKE=250
AMBIENT_MATCH_EVERY=0
DB_PATH=./longshort-ausd.db
HOST=127.0.0.1
PORT=8787
# Put FAUCET_KEY separately in .env.funder.testnet with file permissions 0600.
FAUCET_STAKE=200
