# Arena chain (anvil locally, Monad testnet in prod)
RPC_URL=http://127.0.0.1:8545
# Where live Perpl prices are read from (always Monad testnet)
PERPL_RPC_URL=https://testnet-rpc.monad.xyz
# Keeper/funder key — on anvil this is the default account 0 (deployer)
KEEPER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Pays player gas (EIP-7702). Must be a different key from KEEPER_KEY. Anvil account 1.
# Leave unset to keep the MON faucet and the gas station.
RELAYER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Bot wallets are derived from this mnemonic (index 1..BOT_COUNT)
BOT_MNEMONIC="test test test test test test test test test test test junk"
BOT_COUNT=24
BOT_FILL_AFTER=12
AMBIENT_MATCH_EVERY=45
PORT=8787
HOST=127.0.0.1
# Explicit local opt-out; production always requires both shared server secrets.
GATE_DEV_BYPASS=1
# GATE_PASSWORD=<same value as web>
# GATE_SESSION_SECRET=<same value as web, at least 32 random characters>
# GATE_ORIGIN=https://longshort.fun
DB_PATH=./longshort.db
FAUCET_MON=0.15
