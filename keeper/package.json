{
  "name": "@longshort/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=--no-warnings tsx src/main.ts",
    "dev": "NODE_OPTIONS=--no-warnings tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test GATE_DEV_BYPASS=1 TEST_CHAIN_PROFILE=local NODE_OPTIONS=--no-warnings node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@longshort/shared": "*",
    "viem": "^2.37.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
