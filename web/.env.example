# Copy to web/.env.local. These defaults run against the local stack (anvil + `npm run keeper`).
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Optional: Envio GraphQL for match reports and history (e.g. http://localhost:8080/v1/graphql).
# NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
# gas sent along with join to the in-browser session key (MON)
NEXT_PUBLIC_SESSION_TOPUP=0.3
# Opens the access gate for local development. Ignored when NODE_ENV=production.
GATE_DEV_BYPASS=1

# Monad testnet instead: NEXT_PUBLIC_API_URL=<your keeper URL>, NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# Production web and keeper share these server-only values (never NEXT_PUBLIC_*).
# GATE_PASSWORD=<shared access code>
# GATE_SESSION_SECRET=<at least 32 random characters>
# GATE_ORIGIN=https://longshort.fun
# Enable only behind Caddy, which must overwrite X-Gate-Client-IP with {remote_host}.
# GATE_TRUST_PROXY=1
